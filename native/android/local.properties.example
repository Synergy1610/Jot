# Copy to local.properties (gitignored) and fill in.
sdk.dir=/path/to/android-sdk

# Keep cloud config in secrets.properties so Android Studio can rewrite
# local.properties without removing the Supabase settings.

# Optional: release signing. Without these the release APK is signed with the
# debug key, which is fine for personal sideloading but cannot update a build
# signed with another key.
# JOT_KEYSTORE=/absolute/path/to/jot-release.jks
# JOT_KEYSTORE_PASSWORD=
# JOT_KEY_ALIAS=jot
# JOT_KEY_PASSWORD=
