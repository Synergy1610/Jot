{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jot",
  "version": "0.1.0",
  "identifier": "dev.jot.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jot",
        "width": 480,
        "height": 320,
        "resizable": false,
        "visible": false,
        "focus": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  }
}
