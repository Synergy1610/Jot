# Maintainer: soorya <sooryakiran.edathadan@gmail.com>
pkgname=jot
pkgver=0.1.0
pkgrel=1
pkgdesc="A summoned scratchpad"
arch=('x86_64')
url="https://github.com/Synergy1610/Jot"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg' 'libayatana-appindicator')
makedepends=('git' 'rust' 'pnpm' 'base-devel')
source=("$pkgname"::"git+file:///home/soorya/Projects/jot")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"

  # pnpm may come from mise on this machine; ensure its shims are visible.
  export PATH="$HOME/.local/share/mise/shims:$PATH"

  # makepkg's hardened CFLAGS break sqlx-macros' proc-macro dylib (undefined
  # sqlite3_value_type). Rust handles its own flags; don't pass CFLAGS through.
  unset CFLAGS CXXFLAGS LDFLAGS

  pnpm install --frozen-lockfile
  # tauri build enables the custom-protocol feature so the UI is embedded;
  # plain cargo build --release leaves devUrl in the binary.
  pnpm tauri build
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 src-tauri/target/release/jot "$pkgdir/usr/bin/jot"
  install -Dm644 packaging/jot.desktop "$pkgdir/usr/share/applications/jot.desktop"
  install -Dm644 packaging/jot-autostart.desktop "$pkgdir/etc/xdg/autostart/jot.desktop"
  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/jot.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/jot.png"
  install -Dm644 src-tauri/icons/jot.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/jot.svg"

  gtk-update-icon-cache -q -t -f "$pkgdir/usr/share/icons/hicolor" || true
}
